#!/usr/bin/env bash
# git shim (git_checker). Installed as ~/.local/bin/git, ahead of /usr/bin in PATH.
# Intercepts `git clone` when a person runs it (there is a TTY) or Claude Code does (CLAUDECODE=1)
# and hands it to git-safe-clone. Everything else goes straight to the real git.
#   GIT_CHECK=0        → never intercept
#   GIT_CHECK_FORCE=1  → intercept without a TTY too (scripts)
SELF=$(readlink -f "$0")

real=""
IFS=: read -ra _dirs <<<"$PATH"
for d in "${_dirs[@]}"; do
  c="$d/git"
  if [[ -x $c && $(readlink -f "$c") != "$SELF" ]]; then real=$c; break; fi
done
[[ -n $real ]] || real=/usr/bin/git
export GIT_CHECK_REAL_GIT="$real"

intercept() {
  [[ ${GIT_CHECK:-1} != 0 ]] || return 1
  [[ -t 0 || -t 2 || -n ${CLAUDECODE:-} || -n ${GIT_CHECK_FORCE:-} ]]
}

if intercept; then
  # skip global options to find the subcommand
  args=("$@"); i=0; cdir=""; globals=()
  while ((i < ${#args[@]})); do
    a=${args[i]}
    case $a in
      -C) cdir=${args[i+1]:-}; ((i+=2)) ;;
      -c|--git-dir|--work-tree|--namespace|--exec-path|--config-env) globals+=("$a" "${args[i+1]:-}"); ((i+=2)) ;;
      --*=*|-p|-P|--paginate|--no-pager|--bare|--no-replace-objects|--literal-pathspecs|--no-optional-locks) globals+=("$a"); ((i+=1)) ;;
      *) break ;;
    esac
  done
  if [[ ${args[i]:-} == clone ]]; then
    if ((${#globals[@]})); then
      echo "git_checker: 'git ${globals[*]} clone' is not supported; use 'git clone …' (or GIT_CHECK=0 to skip the review)" >&2
      exit 2
    fi
    [[ -n $cdir ]] && { cd -- "$cdir" || exit 128; }
    exec "$(dirname "$SELF")/git-safe-clone" "${args[@]:i+1}"
  fi
fi
exec "$real" "$@"

#!/usr/bin/env bash
# git-safe-clone — clona en cuarentena, analiza (código + superficie de agentes LLM)
# y solo entrega el repo en su destino si es seguro.
#
#   git-safe-clone [opciones de git clone] <url> [dir]
#   git-safe-clone --scan <dir>                 analiza un directorio ya existente
#   git-safe-clone --release <cuarentena> [--neutralize]   entrega uno retenido
#   git-safe-clone --list                       lista la cuarentena
#
# Variables: GIT_CHECK_NO_LLM=1 (sin fase 3), GIT_CHECK_NO_EXTERNAL=1 (sin semgrep/guarddog/osv),
#            GIT_CHECK_MODEL (opus), GIT_CHECK_QUARANTINE, GIT_CHECK_REPORTS,
#            GIT_CHECK_NONINTERACTIVE=1 (nunca pregunta; WARN y BLOCK se quedan en cuarentena)
set -uo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=$(dirname "$(dirname "$SELF")")
QDIR=${GIT_CHECK_QUARANTINE:-$HOME/.cache/git-checker/quarantine}
RDIR=${GIT_CHECK_REPORTS:-$HOME/.local/share/git-checker/reports}
# git real (no el shim de ~/.local/bin/git, para no entrar en bucle)
GIT=${GIT_CHECK_REAL_GIT:-}
if [[ -z $GIT ]]; then
  for c in $(type -ap git); do [[ $(readlink -f "$c") != "$ROOT/bin/git-shim" ]] && { GIT=$c; break; }; done
fi
[[ -x $GIT ]] || GIT=/usr/bin/git
PY=(python3 -I "$ROOT/gitcheck.py")

red() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
yel() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
grn() { printf '\033[1;32m%s\033[0m\n' "$*" >&2; }
die() { red "git-safe-clone: $*"; exit 2; }

interactive() {
  [[ -z ${GIT_CHECK_NONINTERACTIVE:-} ]] && [[ -t 2 ]] && { : </dev/tty; } 2>/dev/null
}

ask() {  # ask "pregunta" -> respuesta en $REPLY
  printf '%s' "$1" >/dev/tty
  IFS= read -r REPLY </dev/tty || REPLY=""
}

restore_symlinks() {  # el clon se hizo con core.symlinks=false
  local dest=$1 json=$2
  if jq -e '[.findings[] | select(.rule=="symlink-escape")] | length > 0' "$json" >/dev/null 2>&1; then
    yel "  Symlinks que escapan del repo: se dejan como ficheros de texto."
    return
  fi
  local links=()
  while IFS= read -r -d '' entry; do
    [[ $entry == 120000\ * ]] && links+=("${entry#*$'\t'}")
  done < <("$GIT" -C "$dest" ls-files -s -z)
  ((${#links[@]})) && "$GIT" -C "$dest" -c core.hooksPath=/dev/null checkout -q -- "${links[@]}"
}

neutralize() {
  local dest=$1 json=$2 p
  while IFS= read -r p; do
    [[ -z $p || $p == *..* ]] && continue
    if [[ -e $dest/$p || -L $dest/$p ]]; then
      mv -- "$dest/$p" "$dest/$p.quarantined" && yel "  neutralizado: $p → $p.quarantined"
    fi
  done < <(jq -r '.neutralize[]?' "$json")
}

deliver() {  # deliver <qroot> [neutralize]
  local qroot=$1 neu=${2:-} dest
  dest=$(cat "$qroot/dest") || die "cuarentena sin destino: $qroot"
  [[ -e $dest ]] && [[ -n $(ls -A "$dest" 2>/dev/null) ]] && die "el destino ya existe: $dest"
  [[ -d $dest ]] && rmdir "$dest"
  mkdir -p "$(dirname "$dest")"
  mv -- "$qroot/repo" "$dest" || die "no se pudo mover a $dest"
  restore_symlinks "$dest" "$qroot/result.json"
  [[ -n $neu ]] && neutralize "$dest" "$qroot/result.json"
  cp "$qroot/result.json" "$RDIR/$(basename "$qroot").json" 2>/dev/null
  rm -rf -- "$qroot"
  grn "✅ Entregado en $dest"
}

analyze() {  # analyze <dir> <name> <json> <report>
  mkdir -p "$RDIR"
  local flags=()
  [[ -n ${GIT_CHECK_NO_LLM:-} ]] && flags+=(--no-llm)
  [[ -n ${GIT_CHECK_NO_EXTERNAL:-} ]] && flags+=(--no-external)
  "${PY[@]}" "$1" --name "$2" --json "$3" --report "$4" "${flags[@]}"
}

# ------------------------------------------------------------------ subcomandos
case ${1:-} in
  ""|-h|--help) sed -n '2,15p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --list) ls -1t "$QDIR" 2>/dev/null; exit 0 ;;
  --scan)
    [[ -d ${2:-} ]] || die "uso: --scan <dir>"
    d=$(readlink -f "$2"); ts=$(date +%Y%m%d-%H%M%S)
    tmp=$(mktemp -d); rep="$RDIR/$(basename "$d")-$ts.md"
    analyze "$d" "$(basename "$d")" "$tmp/result.json" "$rep"; rc=$?
    echo "  Informe: $rep" >&2; rm -rf "$tmp"; exit $rc ;;
  --release)
    q=$(readlink -f "${2:-}"); [[ -d $q/repo && $q == "$(readlink -f "$QDIR")"/* ]] || die "uso: --release <dir de cuarentena>"
    deliver "$q" "$([[ ${3:-} == --neutralize ]] && echo 1)"; exit 0 ;;
esac

# ------------------------------------------------------------------ parseo de 'git clone'
opts=(); pos=(); bare=""
while (($#)); do
  case $1 in
    --) shift; pos+=("$@"); break ;;
    --recurse-submodules|--recurse-submodules=*|--recursive|--shallow-submodules)
      yel "⚠  $1 ignorado: los submódulos no se clonan hasta revisar el repo"; shift ;;
    -u|--upload-pack|--upload-pack=*|-u?*|--template|--template=*|--separate-git-dir|--separate-git-dir=*)
      die "opción $1 no permitida (ejecuta comandos o plantillas)" ;;
    -c|--config)
      [[ ${2:-} =~ ^(core\.|protocol\.|submodule\.|filter\.|uploadpack\.|credential\.|include) ]] && die "config peligrosa: $2"
      opts+=("$1" "$2"); shift 2 ;;
    --config=*|-c?*)
      [[ ${1#*=} =~ ^(core\.|protocol\.|submodule\.|filter\.|uploadpack\.|credential\.|include) || ${1#-c} =~ ^(core\.|protocol\.) ]] && die "config peligrosa: $1"
      opts+=("$1"); shift ;;
    --bare|--mirror) bare=1; opts+=("$1"); shift ;;
    -b|--branch|-o|--origin|--depth|--shallow-since|--shallow-exclude|--reference|--reference-if-able|\
    --filter|-j|--jobs|--bundle-uri|--server-option|--ref-format)
      opts+=("$1" "${2:-}"); shift 2 ;;
    -*) opts+=("$1"); shift ;;
    *) pos+=("$1"); shift ;;
  esac
done
((${#pos[@]} >= 1 && ${#pos[@]} <= 2)) || die "uso: git clone [opciones] <url> [directorio]"
url=${pos[0]}
if ((${#pos[@]} == 2)); then
  dest=${pos[1]}
else
  n=${url%/}; n=${n%.git}; n=${n##*/}; n=${n##*:}
  dest=$n${bare:+.git}
fi
name=$(basename -- "$dest")
[[ -n $name && $name != . && $name != .. ]] || die "no puedo deducir el directorio destino de: $url"
dest=$(readlink -m -- "$dest")
[[ -e $dest && -n $(ls -A "$dest" 2>/dev/null) ]] && die "fatal: el destino '$dest' ya existe y no está vacío"

ts=$(date +%Y%m%d-%H%M%S)
qroot="$QDIR/$name-$ts-$$"
mkdir -p "$qroot" "$RDIR" || die "no puedo crear $qroot"
chmod 700 "$QDIR" 2>/dev/null
printf '%s' "$dest" >"$qroot/dest"

yel "🔒 Clonando en cuarentena: $qroot/repo"
GIT_LFS_SKIP_SMUDGE=1 GIT_CONFIG_PARAMETERS= "$GIT" \
  -c core.hooksPath=/dev/null \
  -c core.symlinks=false \
  -c core.fsmonitor=false \
  -c protocol.file.allow=user \
  -c protocol.ext.allow=never \
  -c submodule.recurse=false \
  -c transfer.fsckObjects=true \
  -c fetch.fsckObjects=true \
  -c filter.lfs.smudge= -c filter.lfs.process= -c filter.lfs.required=false \
  clone --no-recurse-submodules "${opts[@]}" -- "$url" "$qroot/repo" || { rm -rf -- "$qroot"; exit 128; }

report="$RDIR/$name-$ts.md"
analyze "$qroot/repo" "$name" "$qroot/result.json" "$report"; rc=$?
echo "  Informe: $report" >&2

case $rc in
  0) deliver "$qroot" ;;
  10)
    if interactive; then
      while :; do
        ask $'\n¿Qué hago? [a]ceptar  [n]eutralizar config de agentes y aceptar  [r]echazar  [v]er informe: '
        case $REPLY in
          a|A) deliver "$qroot"; break ;;
          n|N) deliver "$qroot" 1; break ;;
          v|V) ${PAGER:-less -R} "$report" </dev/tty >/dev/tty ;;
          *) yel "Retenido en cuarentena: $qroot  (git-safe-clone --release $qroot [--neutralize])"; exit 10 ;;
        esac
      done
    else
      yel "WARN: retenido en cuarentena: $qroot"
      yel "  Revisa $report y entrega con: git-safe-clone --release $qroot [--neutralize]"
      exit 10
    fi ;;
  20)
    red "⛔ BLOCK: el repositorio NO se ha entregado. Retenido en: $qroot"
    red "   Informe: $report"
    if interactive; then
      ask $'Para entregarlo igualmente (NEUTRALIZADO) escribe ACEPTO; cualquier otra cosa lo deja retenido: '
      [[ $REPLY == ACEPTO ]] && { deliver "$qroot" 1; exit 0; }
    fi
    exit 20 ;;
  *) red "Error del analizador (rc=$rc). Retenido en: $qroot"; exit "$rc" ;;
esac

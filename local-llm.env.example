# Second opinion from a local LLM (OpenAI-compatible API: llama.cpp server, vLLM, Ollama /v1, LM Studio…)
# Copy to ~/.config/git-checker/local-llm.env and chmod 600 (it holds the token).
# Read as KEY=VALUE; it is never executed as shell.
GIT_CHECK_LOCAL_URL=http://127.0.0.1:8081/v1
GIT_CHECK_LOCAL_MODEL=qwen3-coder-30b
GIT_CHECK_LOCAL_KEY=
# GIT_CHECK_LOCAL_TIMEOUT=900
# GIT_CHECK_LOCAL_MAX_CHARS=60000   # shrinks automatically if the server has less context
# GIT_CHECK_LOCAL_WEIGHT=second     # second: its BLOCK → WARN at most; full: same weight as Opus

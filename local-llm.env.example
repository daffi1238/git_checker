# Segunda opinión con un LLM local (API compatible OpenAI: llama.cpp server, vLLM, Ollama /v1, LM Studio…)
# Copia a ~/.config/git-checker/local-llm.env y haz chmod 600 (lleva el token).
# Se lee como KEY=VALUE; no se ejecuta como shell.
GIT_CHECK_LOCAL_URL=http://127.0.0.1:8081/v1
GIT_CHECK_LOCAL_MODEL=qwen3-coder-30b
GIT_CHECK_LOCAL_KEY=
# GIT_CHECK_LOCAL_TIMEOUT=900
# GIT_CHECK_LOCAL_MAX_CHARS=60000   # se reduce solo si el servidor tiene menos contexto
# GIT_CHECK_LOCAL_WEIGHT=second     # second: su BLOCK → como mucho WARN; full: mismo peso que Opus
